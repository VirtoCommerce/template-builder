{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "cli": {
        "analytics": false
    },
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "template-builder": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                },
                "@schematics/angular:application": {
                    "strict": true
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-builders/custom-webpack:browser",
                    "options": {
                        "outputPath": "dist/template-builder",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets",
                            {
                                "glob": "**/*",
                                "input": "./node_modules/ckeditor4",
                                "output": "external/ckeditor"
                            },
                            "src/data",
                            "src/demo"
                        ],
                        "styles": [
                            "node_modules/ngx-toastr/toastr.css",
                            "node_modules/easymde/dist/easymde.min.css",
                            "src/styles.scss"
                        ],
                        "scripts": [],
                        "allowedCommonJsDependencies": [
                            "easymde",
                            "element-resize-detector",
                            "turndown"
                        ],
                        "customWebpackConfig": {
                            "path": "./webpack.config.js"
                        }
                    },
                    "configurations": {
                        "production": {
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "1500kb",
                                    "maximumError": "5mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "2kb",
                                    "maximumError": "4kb"
                                }
                            ],
                            "fileReplacements": [
                                {
                                    "replace": "src/environments/environment.ts",
                                    "with": "src/environments/environment.prod.ts"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "buildOptimizer": false,
                            "optimization": false,
                            "vendorChunk": true,
                            "extractLicenses": false,
                            "sourceMap": true,
                            "namedChunks": true
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular-builders/custom-webpack:dev-server",
                    "configurations": {
                        "production": {
                            "browserTarget": "template-builder:build:production"
                        },
                        "development": {
                            "browserTarget": "template-builder:build:development"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "template-builder:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.spec.json",
                        "karmaConfig": "karma.conf.js",
                        "inlineStyleLanguage": "scss",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": ["src/styles.scss"],
                        "scripts": []
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "src/**/*.ts",
                            "src/**/*.html"
                        ]
                    }
                }
            }
        },
        "ngv-markdown": {
            "projectType": "library",
            "root": "projects/ngv-markdown",
            "sourceRoot": "projects/ngv-markdown/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/ngv-markdown/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ngv-markdown/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ngv-markdown/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "projects/ngv-markdown/src/test.ts",
                        "tsConfig": "projects/ngv-markdown/tsconfig.spec.json",
                        "karmaConfig": "projects/ngv-markdown/karma.conf.js"
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/ngv-markdown/src/**/*.ts",
                            "projects/ngv-markdown/src/**/*.html"
                        ]
                    }
                }
            }
        },
        "ngv-datepicker": {
            "projectType": "library",
            "root": "projects/ngv-datepicker",
            "sourceRoot": "projects/ngv-datepicker/src",
            "prefix": "lib",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:ng-packagr",
                    "options": {
                        "project": "projects/ngv-datepicker/ng-package.json"
                    },
                    "configurations": {
                        "production": {
                            "tsConfig": "projects/ngv-datepicker/tsconfig.lib.prod.json"
                        },
                        "development": {
                            "tsConfig": "projects/ngv-datepicker/tsconfig.lib.json"
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "projects/ngv-datepicker/src/test.ts",
                        "tsConfig": "projects/ngv-datepicker/tsconfig.spec.json",
                        "karmaConfig": "projects/ngv-datepicker/karma.conf.js"
                    }
                },
                "lint": {
                    "builder": "@angular-eslint/builder:lint",
                    "options": {
                        "lintFilePatterns": [
                            "projects/ngv-datepicker/src/**/*.ts",
                            "projects/ngv-datepicker/src/**/*.html"
                        ]
                    }
                }
            }
        }
    }
}
