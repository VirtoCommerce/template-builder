{
  "name": "template-builder",
  "version": "0.0.0",
  "scripts": {
    "watch": "ng build --watch --configuration development",
    "build": "ng build ngv-markdown && ng build ngv-datepicker && npm run build:datepicker:themes && ng build",
    "build:datepicker": "ng build ngv-datepicker && npm run build:datepicker:themes",
    "build:datepicker:themes": "sass --load-path=node_modules --silence-deprecation=global-builtin --silence-deprecation=import --silence-deprecation=if-function projects/ngv-datepicker/src/lib/prebuilt-themes:dist/ngv-datepicker/prebuilt-themes --style=compressed",
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "lint": "ng lint"
  },
  "private": true,
  "workspaces": [
    "projects/ngv-markdown",
    "projects/ngv-datepicker"
  ],
  "dependencies": {
    "@angular/animations": "^20.3.18",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^20.3.18",
    "@angular/compiler": "^20.3.18",
    "@angular/core": "^20.3.18",
    "@angular/forms": "^20.3.18",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^20.3.18",
    "@angular/platform-browser-dynamic": "^20.3.18",
    "@angular/router": "^20.3.18",
    "@github/paste-markdown": "^1.4.2",
    "@iplab/ngx-file-upload": "^19.0.4",
    "@ng-select/ng-select": "^14.9.0",
    "@ngrx/effects": "^19.2.1",
    "@ngrx/router-store": "^19.2.1",
    "@ngrx/store": "^19.2.1",
    "@ngrx/store-devtools": "^19.2.1",
    "chrono-node": "^2.9.0",
    "ckeditor4": "^4.25.1",
    "ckeditor4-angular": "^5.2.1",
    "jsonpath-plus": "^10.4.0",
    "lodash-es": "^4.17.21",
    "ngx-color": "^9.0.0",
    "ngx-cookie-service": "^19.1.2",
    "ngx-scrollbar": "^18.0.0",
    "ngx-toastr": "^19.1.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.4.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.20",
    "@angular-devkit/build-angular": "^20.3.20",
    "@angular-devkit/core": "^20.3.20",
    "@angular-eslint/builder": "^19.8.1",
    "@angular-eslint/eslint-plugin": "^19.8.1",
    "@angular-eslint/eslint-plugin-template": "^19.8.1",
    "@angular-eslint/schematics": "^19.8.1",
    "@angular-eslint/template-parser": "^19.8.1",
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@angular/cli": "^20.3.20",
    "@angular/compiler-cli": "^20.3.18",
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/typography": "^0.5.2",
    "@types/jasmine": "^5.1.15",
    "@types/lodash-es": "^4.17.6",
    "@types/node": "^20.19.37",
    "@types/turndown": "^5.0.1",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/types": "^8.0.0",
    "@typescript-eslint/utils": "^8.0.0",
    "eslint": "^9.0.0",
    "jasmine-core": "^5.13.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "ng-packagr": "^20.3.2",
    "postcss": "^8.4.14",
    "sass": "^1.69.0",
    "tailwindcss": "^3.0.24",
    "typescript": "~5.8.3"
  },
  "packageManager": "yarn@1.22.21+sha1.1959a18351b811cdeedbd484a8f86c3cc3bbaf72"
}
